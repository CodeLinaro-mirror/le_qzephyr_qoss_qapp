+)
+# aes-eax: AES-EAX mode cipher, only needed for EAP-IKEv2 (~6 KB)
+if(CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE AND CONFIG_EAP_IKEV2)
+  zephyr_library_sources(${HOSTAP_SRC_BASE}/crypto/aes-eax.c)
+endif()
+# fips_prf_internal: FIPS 186-2 PRF, only needed for EAP-SIM/AKA and EAP-LEAP (~4 KB)
+if(CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE)
+  if(CONFIG_EAP_SIM OR CONFIG_EAP_AKA OR CONFIG_EAP_LEAP)
+    zephyr_library_sources(${HOSTAP_SRC_BASE}/crypto/fips_prf_internal.c)
+  endif()
+endif()
+# milenage: MILENAGE algorithm, only needed for EAP-SIM/AKA (~11 KB)
+if(CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE)
+  if(CONFIG_EAP_SIM OR CONFIG_EAP_AKA)
+    zephyr_library_sources(${HOSTAP_SRC_BASE}/crypto/milenage.c)
+  endif()
+endif()
+
+zephyr_library_sources_ifdef(CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_TEST
+  ${HOSTAP_SRC_BASE}/crypto/crypto_module_tests.c
   ${HOSTAP_SRC_BASE}/crypto/fips_prf_internal.c
-  ${HOSTAP_SRC_BASE}/crypto/milenage.c
+  ${HOSTAP_SRC_BASE}/crypto/sha1-internal.c
+  ${HOSTAP_SRC_BASE}/crypto/sha1-tlsprf.c
+)
+endif()
