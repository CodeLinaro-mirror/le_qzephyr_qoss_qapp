+SHELL_SUBCMD_ADD((wifi), load_certs, NULL,
+		 "Manage EAP-TLS certificates in LittleFS.\n"
+		 "  -c, --ca       <path>  Load CA certificate (PEM)\n"
+		 "  -k, --key      <path>  Load client private key (PEM)\n"
+		 "  -e, --cert     <path>  Load client certificate (PEM)\n"
+		 "  -p, --key-pass <pass>  Passphrase for encrypted private key\n"
+		 "                         (visible in logs — development use only)\n"
+		 "  -l, --list             Show loaded credentials and LittleFS files\n"
+		 "      --clear            Unload all credentials from memory\n"
+		 "Examples:\n"
+		 "  wifi load_certs -c /lfs/ca.pem\n"
+		 "  wifi load_certs -k /lfs/client.key -p secret -e /lfs/client.crt\n"
+		 "  wifi load_certs --list\n"
+		 "  wifi load_certs --clear\n",
+		 cmd_wifi_load_certs,
+		 1, 10);
+#endif /* CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES && CONFIG_FILE_SYSTEM_LITTLEFS */
+
