+# aes-eax: AES-EAX mode cipher, only needed for EAP-IKEv2 (~6 KB)
+if(CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE AND CONFIG_EAP_IKEV2)
+  zephyr_library_sources(${HOSTAP_SRC_BASE}/crypto/aes-eax.c)
