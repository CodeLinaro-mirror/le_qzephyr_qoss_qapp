+#ifdef CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE
+/* Called from qwifi_drv_connect() for EAP security types.
+ * Configures wpa_supplicant with EAP credentials (method, certs, identity)
+ * and enables the network, but does NOT call select_network — the firmware
+ * initiates 802.11 auth+assoc directly via qapi_WLAN_Commit().
+ * After QAPI_WLAN_CONNECT_CB_E fires, enterprise_glue posts EVENT_ASSOC
+ * to the supplicant, which starts the EAP state machine.
+ */
+int supplicant_config_enterprise_network(const struct device *dev,
+					 struct wifi_connect_req_params *params)
+{
+	struct wpa_supplicant *wpa_s;
+	int ret = 0;
+
+	if (!net_if_is_admin_up(net_if_lookup_by_dev(dev))) {
+		wpa_printf(MSG_ERROR, "Interface %s is down", dev->name);
+		return -1;
+	}
+
+	k_mutex_lock(&wpa_supplicant_mutex, K_FOREVER);
+
+	wpa_s = get_wpa_s_handle(dev);
+	if (!wpa_s) {
+		ret = -1;
+		wpa_printf(MSG_ERROR, "Device %s not found", dev->name);
+		goto out;
+	}
+
+	ret = wpas_add_and_config_network(wpa_s, params, false, false);
+	if (ret) {
+		wpa_printf(MSG_ERROR, "Enterprise network config failed: %d", ret);
+	}
+
+out:
+	k_mutex_unlock(&wpa_supplicant_mutex);
+	return ret;
+}
+#endif /* CONFIG_WIFI_NM_WPA_SUPPLICANT_CRYPTO_ENTERPRISE */
