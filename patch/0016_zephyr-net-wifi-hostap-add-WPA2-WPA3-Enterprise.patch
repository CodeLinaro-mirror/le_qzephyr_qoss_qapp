+#if defined(CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES) && \
+    defined(CONFIG_FILE_SYSTEM_LITTLEFS)
+static int cmd_wifi_load_certs(const struct shell *sh, size_t argc,
+                               char *argv[])
+{
+	const char *ca_path = NULL;
+	const char *key_path = NULL;
+	const char *cert_path = NULL;
+	const char *key_pass = NULL;
+	bool do_list = false;
+	bool do_clear = false;
+	struct getopt_state *state;
+	int opt, opt_index = 0;
+	int ret;
+	static const struct option long_options[] = {
+		{"ca",       required_argument, 0, 'c'},
+		{"key",      required_argument, 0, 'k'},
+		{"cert",     required_argument, 0, 'e'},
+		{"key-pass", required_argument, 0, 'p'},
+		{"list",     no_argument,       0, 'l'},
+		/* 'x' is intentionally absent from the short-opts string —
+		 * --clear has no short-form alias to avoid accidental use. */
+		{"clear",    no_argument,       0, 'x'},
+		{NULL, 0, NULL, 0}
+	};
+
+	while ((opt = getopt_long(argc, argv, "c:k:e:p:l",
+				  long_options, &opt_index)) != -1) {
+		state = getopt_state_get();
+		switch (opt) {
+		case 'c':
+			ca_path = state->optarg;
+			break;
+		case 'k':
+			key_path = state->optarg;
+			break;
+		case 'e':
+			cert_path = state->optarg;
+			break;
+		case 'p':
+			key_pass = state->optarg;
+			break;
+		case 'l':
+			do_list = true;
+			break;
+		case 'x':
+			do_clear = true;
+			break;
+		default:
+			shell_help(sh);
+			return -ENOEXEC;
+		}
+	}
+
+	if (do_clear) {
+		wifi_clear_certs();
+		PR("Certificates cleared.\n");
+		return 0;
+	}
+
+	if (do_list) {
+		wifi_list_certs(sh);
+		return 0;
+	}
+
+	if (!ca_path && !key_path && !cert_path) {
+		shell_help(sh);
+		return -ENOEXEC;
+	}
+
+	if (key_pass && !key_path) {
+		PR_ERROR("load_certs: --key-pass requires --key\n");
+		return -ENOEXEC;
+	}
+
+	ret = wifi_load_certs_from_fs(ca_path, key_path, cert_path, key_pass);
+	if (ret < 0) {
+		PR_ERROR("load_certs: failed (%d)\n", ret);
+		return ret;
+	}
+
+	PR("Certificates loaded successfully.\n");
+	return 0;
+}
+#endif /* CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES && CONFIG_FILE_SYSTEM_LITTLEFS */
