diff --git a/include/zephyr/net/wifi_certs.h b/include/zephyr/net/wifi_certs.h
index ea9e02cf104..991eb09e4cb 100644
--- a/include/zephyr/net/wifi_certs.h
+++ b/include/zephyr/net/wifi_certs.h
@@ -35,4 +35,59 @@ int wifi_set_enterprise_credentials(struct net_if *iface, bool is_ap);
  */
 void wifi_clear_enterprise_credentials(void);
 
+#ifdef CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES
+/**
+ * @brief TLS credential sec_tags used for enterprise certificates.
+ *
+ * Both wifi_certs.c and the platform cert loader must use these values —
+ * define them here once rather than duplicating in each file.
+ */
+enum wifi_enterprise_cert_sec_tags {
+	WIFI_CERT_CA_SEC_TAG = 0x1020001,
+	WIFI_CERT_CLIENT_KEY_SEC_TAG,
+	WIFI_CERT_SERVER_KEY_SEC_TAG,
+	WIFI_CERT_CLIENT_SEC_TAG,
+	WIFI_CERT_SERVER_SEC_TAG,
+	/* Phase 2 */
+	WIFI_CERT_CA_P2_SEC_TAG,
+	WIFI_CERT_CLIENT_KEY_P2_SEC_TAG,
+	WIFI_CERT_CLIENT_P2_SEC_TAG,
+};
+#endif /* CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES */
+
+#if defined(CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES) && \
+    defined(CONFIG_FILE_SYSTEM_LITTLEFS)
+
+struct shell; /* forward declaration — avoids pulling in shell headers */
+
+/**
+ * @brief Load EAP-TLS certificates from specified file paths.
+ *
+ * Each path parameter is optional; pass NULL to skip that credential.
+ * LittleFS is mounted lazily on the first call.  Previously loaded
+ * credentials for the same tag are replaced; others are left intact.
+ *
+ * @param ca_path   Path to CA certificate PEM file, or NULL
+ * @param key_path  Path to client private key PEM file, or NULL
+ * @param cert_path Path to client certificate PEM file, or NULL
+ * @param key_pass  Passphrase for an encrypted private key, or NULL
+ * @return 0 on success, negative errno on failure
+ */
+int wifi_load_certs_from_fs(const char *ca_path, const char *key_path,
+                             const char *cert_path, const char *key_pass);
+
+/**
+ * @brief Show loaded credential status and LittleFS file listing.
+ *
+ * @param sh Shell instance for output
+ */
+void wifi_list_certs(const struct shell *sh);
+
+/**
+ * @brief Unload all certificates from the TLS credentials store.
+ */
+void wifi_clear_certs(void);
+
+#endif /* CONFIG_WIFI_SHELL_RUNTIME_CERTIFICATES && CONFIG_FILE_SYSTEM_LITTLEFS */
+
 #endif /* WIFI_CERTS_H__ */
