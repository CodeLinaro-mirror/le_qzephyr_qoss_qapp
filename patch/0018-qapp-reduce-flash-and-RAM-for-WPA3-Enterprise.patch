+/*
+ * On fullmac devices ctrl_iface.c / wpa_cli_zephyr.c are not compiled in.
+ * This dispatcher parses the traditional "COMMAND [args...]" string and
+ * calls the appropriate wpa_supplicant internal API directly.
+ *
+ * Supported patterns (exhaustive list used by wpas_add_and_config_network):
+ *   remove_network all
+ *   remove_network <id>
+ *   set_network <id> <field> [<value>]
+ *   enable_network <id>
+ *   select_network <id>
+ *   set <field> <value>
+ *   disconnect
+ */
+
+/* Extract the next whitespace-delimited word from *p into dst (nul-terminated).
+ * Advances *p past the word and trailing whitespace.
+ * Returns false if the string is empty.
+ */
+static bool _next_word(const char **p, char *dst, size_t dst_size)
+{
+	const char *s = *p;
+	size_t n;
+
+	while (*s == ' ')
+		s++;
+	if (*s == '\0') {
+		*p = s;
+		return false;
+	}
+	n = 0;
+	while (*s && *s != ' ' && n + 1 < dst_size)
+		dst[n++] = *s++;
+	dst[n] = '\0';
+	while (*s == ' ')
+		s++;
+	*p = s;
+	return true;
+}
+
+/* Strip one layer of surrounding double-quotes from *s.
+ * wpa_config_set() expects unquoted values for string fields.
+ */
+static const char *_strip_quotes(const char *s, char *buf, size_t bufsz)
+{
+	size_t len = strlen(s);
+
+	if (len >= 2 && s[0] == '"' && s[len - 1] == '"') {
+		size_t inner = len - 2;
+		if (inner >= bufsz)
+			inner = bufsz - 1;
+		memcpy(buf, s + 1, inner);
+		buf[inner] = '\0';
+		return buf;
+	}
+	return s;
+}
+
+static int _fullmac_wpa_cmd_v(struct wpa_supplicant *wpa_s,
+			      const char *fmt, ...)
+{
+	char cmd[512];
+	va_list ap;
+	const char *p;
+	char word0[64], word1[64], word2[64];
+	char stripbuf[256];
+
