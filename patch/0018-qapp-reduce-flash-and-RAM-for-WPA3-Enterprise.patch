+			return -1;
+		int id = atoi(word1);
+		struct wpa_ssid *ssid = wpa_config_get_network(wpa_s->conf, id);
+		wpa_supplicant_enable_network(wpa_s, ssid);
+		return 0;
+	}
+
+	/* select_network <id> */
+	if (os_strcasecmp(word0, "select_network") == 0) {
+		if (!_next_word(&p, word1, sizeof(word1)))
+			return -1;
+		int id = atoi(word1);
+		struct wpa_ssid *ssid = wpa_config_get_network(wpa_s->conf, id);
+		wpa_supplicant_select_network(wpa_s, ssid);
+		return 0;
+	}
+
+	/* set <field> <value> */
+	if (os_strcasecmp(word0, "set") == 0) {
+		if (!_next_word(&p, word1, sizeof(word1)))
+			return -1;
+		if (os_strcmp(word1, "openssl_ciphers") == 0) {
