+	if (os_strcasecmp(word0, "disconnect") == 0) {
+		wpa_supplicant_deauthenticate(wpa_s, WLAN_REASON_DEAUTH_LEAVING);
+		return 0;
+	}
+
+	wpa_printf(MSG_WARNING, "FULLMAC: unhandled cmd: %s", word0);
+	return -1;
