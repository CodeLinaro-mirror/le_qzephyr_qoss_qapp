+/*
+ * BSS table stubs and event socket helper for fullmac devices.
+ *
+ * On fullmac devices (e.g. QCC730) the firmware handles all scan/connect
+ * operations internally, so the BSS table in the host supplicant is always
+ * empty.  We still need the wpa_bss_* symbols to link because wpa_supplicant.c
+ * references them unconditionally.  The dl_list heads must be initialised so
+ * that list-iteration code does not crash on an uninitialised pointer.
+ *
+ * send_data() is the event FIFO helper used by zephyr_wifi_send_event() to
+ * deliver firmware events (connect/disconnect) to the supplicant event loop.
+ * It is normally in ctrl_iface_zephyr.c which we exclude from the FULLMAC
+ * build, so we provide a self-contained copy here.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "includes.h"
+#include "common.h"
+#include "wpa_supplicant_i.h"
+#include "wpa_supplicant/bss.h"
+#include "ctrl_iface_zephyr.h"
+
+#include <zephyr/kernel.h>
+#include <zephyr/zvfs/eventfd.h>
+
+int send_data(struct k_fifo *fifo, int sock, const char *buf, size_t len, int flags)
+{
+	struct zephyr_msg *msg;
+
+	msg = os_zalloc(sizeof(struct zephyr_msg));
+	if (msg == NULL) {
+		wpa_printf(MSG_ERROR, "malloc(ctrl_iface): %s", "out of memory");
+		return -ENOMEM;
+	}
+
+	msg->data = os_zalloc(len + 1);
+	if (msg->data == NULL) {
+		wpa_printf(MSG_ERROR, "malloc(ctrl_iface): %s", "out of memory");
+		os_free(msg);
+		return -ENOMEM;
+	}
+
+	memcpy(msg->data, buf, len);
+	msg->len = len;
+
+	k_fifo_put(fifo, msg);
+	zvfs_eventfd_write(sock, 1);
+
+	return 0;
+}
