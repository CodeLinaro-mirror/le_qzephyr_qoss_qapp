diff --git a/src/drivers/driver_zephyr.c b/src/drivers/driver_zephyr.c
index 1094d562d..8cd4bd388 100644
--- a/src/drivers/driver_zephyr.c
+++ b/src/drivers/driver_zephyr.c
@@ -376,10 +376,41 @@ void wpa_supplicant_event_wrapper(void *ctx,
 			data_tmp->unprot_disassoc.sa = sa;
 			os_memcpy(da, data->unprot_disassoc.da, ETH_ALEN);
 			data_tmp->unprot_disassoc.da = da;
+		} else if (event == EVENT_EAPOL_RX) {
+			/*
+			 * Deep-copy EAPOL_RX so EAP processing runs in the
+			 * wpa_supplicant thread (large stack) rather than the
+			 * caller's context (data_path_task, 2 KB stack).
+			 */
+			union wpa_event_data *data_tmp = msg.data;
+			u8 *src_copy = os_zalloc(ETH_ALEN);
+			u8 *frame_copy = os_zalloc(data->eapol_rx.data_len);
+
+			if (!src_copy || !frame_copy) {
+				wpa_printf(MSG_ERROR,
+				  "%s:%d EVENT_EAPOL_RX alloc failed (src=%p frame=%p)\n",
+				  __func__, __LINE__, src_copy, frame_copy);
+				os_free(src_copy);
+				os_free(frame_copy);
+				os_free(msg.data);
+				return;
+			}
+			os_memcpy(src_copy, data->eapol_rx.src, ETH_ALEN);
+			os_memcpy(frame_copy, data->eapol_rx.data, data->eapol_rx.data_len);
+			data_tmp->eapol_rx.src = src_copy;
+			data_tmp->eapol_rx.data = frame_copy;
 		}
 	}
 
-	zephyr_wifi_send_event(&msg);
+	if (zephyr_wifi_send_event(&msg) != 0) {
+		if (event == EVENT_EAPOL_RX && msg.data) {
+			union wpa_event_data *d = msg.data;
+
+			os_free((void *)d->eapol_rx.src);
+			os_free((void *)d->eapol_rx.data);
+		}
+		os_free(msg.data);
+	}
 }
 
 void wpa_drv_zep_event_chan_list_changed(struct zep_drv_if_ctx *if_ctx, union wpa_event_data *event)
@@ -549,6 +580,13 @@ void wpa_drv_zep_event_proc_assoc_resp(struct zep_drv_if_ctx *if_ctx,
 			  event->assoc_info.addr,
 			  ETH_ALEN);
 
+		wpa_printf(MSG_DEBUG,
+			   "%s: posting EVENT_ASSOC bssid=%02x:%02x:%02x:%02x:%02x:%02x ssid_len=%d",
+			   __func__,
+			   if_ctx->bssid[0], if_ctx->bssid[1], if_ctx->bssid[2],
+			   if_ctx->bssid[3], if_ctx->bssid[4], if_ctx->bssid[5],
+			   if_ctx->ssid_len);
+
 		wpa_supplicant_event_wrapper(if_ctx->supp_if_ctx,
 				EVENT_ASSOC,
 				event);
@@ -1841,9 +1879,10 @@ static int wpa_drv_zep_get_ssid(void *priv,
 	if_ctx = priv;
 
 	wpa_printf(MSG_DEBUG,
-		   "%s: SSID size: %d",
+		   "%s: ssid_len=%d ssid=\"%.*s\"",
 		   __func__,
-		   if_ctx->ssid_len);
+		   if_ctx->ssid_len,
+		   if_ctx->ssid_len, (const char *)if_ctx->ssid);
 
 	os_memcpy(ssid, if_ctx->ssid, if_ctx->ssid_len);
 
@@ -2809,3 +2848,43 @@ const struct wpa_driver_ops wpa_driver_zep_ops = {
 	.cancel_remain_on_channel = wpa_drv_zep_cancel_remain_on_channel,
 	.send_action_cancel_wait = wpa_drv_zep_send_action_cancel_wait,
 };
+
+#ifdef CONFIG_WIFI_QCOM_ENTERPRISE
+#include "wpa_supplicant_i.h"
+#include "eapol_supp/eapol_supp_sm.h"
+
+void wpa_drv_zep_eapol_suppress_start(struct zep_drv_if_ctx *if_ctx)
+{
+	struct wpa_supplicant *wpa_s = if_ctx->supp_if_ctx;
+
+	if (!wpa_s || !wpa_s->eapol)
+		return;
+
+	/*
+	 * On PMKSA cache-hit, prevent the host EAPOL SM from sending a
+	 * self-initiated EAPOL-Start while keeping it alive for AP-initiated
+	 * EAP exchanges (periodic PMK refresh, hostapd reauth).
+	 *
+	 * 1. maxStart=0: SUPP_PAE_CONNECTING's startWhen expires -> startCount(0)
+	 *    >= maxStart(0) -> SM transitions to AUTHENTICATED without sending
+	 *    any EAPOL-Start frame.  portEnabled is left true -> no DISCONNECTED
+	 *    -> no deauth callback -> connection stays up.
+	 *    AP-initiated EAP-Request still works: eapolEap=true (AP EAP-Request)
+	 *    -> SM: AUTHENTICATED -> RESTART -> AUTHENTICATING -> normal EAP exchange.
+	 *
+	 * 2. portValid=true: required to stay in AUTHENTICATED state.
+	 *    (In the normal full-EAP path portValid is set by set_supp_port,
+	 *    which is a no-op stub in our fullmac glue -- set it here instead.)
+	 *
+	 * 3. cancel_auth_timeout + set_state(WPA_COMPLETED): prevents the
+	 *    10s auth timeout from firing and calling wpa_supplicant_deauthenticate(),
+	 *    which would trigger supplicant_send_wifi_mgmt_disc_event() with
+	 *    wpa_state < WPA_COMPLETED -> WIFI_STATUS_CONN_FAIL -> shell prints
+	 *    "Connection request failed" even though the link is up.
+	 */
+	eapol_sm_configure(wpa_s->eapol, -1, -1, -1, 0);
+	eapol_sm_notify_portValid(wpa_s->eapol, true);
+	wpa_supplicant_cancel_auth_timeout(wpa_s);
+	wpa_supplicant_set_state(wpa_s, WPA_COMPLETED);
+}
+#endif /* CONFIG_WIFI_QCOM_ENTERPRISE */
diff --git a/src/drivers/driver_zephyr.h b/src/drivers/driver_zephyr.h
index a24a8ead8..2a1af9cc0 100644
--- a/src/drivers/driver_zephyr.h
+++ b/src/drivers/driver_zephyr.h
@@ -354,4 +354,24 @@ struct zep_wpa_supp_dev_ops {
 	int (*signal_monitor)(void *if_priv, int threshold, int hysteresis);
 };
 
+/* Forward declaration for use by fullmac drivers that post assoc events */
+struct zep_drv_if_ctx;
+void wpa_drv_zep_event_proc_assoc_resp(struct zep_drv_if_ctx *if_ctx,
+				       union wpa_event_data *event,
+				       unsigned int status);
+
+/*
+ * Suppress self-initiated EAPOL-Start on PMKSA cache-hit.
+ *
+ * Sets maxStart=0 so the SUPP_PAE SM transitions CONNECTING->AUTHENTICATED
+ * without sending any EAPOL-Start frames.  The SM stays alive and responds
+ * normally to AP-initiated EAP-Requests (periodic PMK refresh, reauth).
+ *
+ * Called by the QCC730 enterprise glue after a PMKSA cache-hit 4WHS completes
+ * (set_key(KEY_FLAG_PMK) was never called, so no EAP exchange occurred).
+ * Without this, the SM would send EAPOL-Start ~2s later, triggering a
+ * fast-reauth that produces a new PMK conflicting with the firmware's cached PMK.
+ */
+void wpa_drv_zep_eapol_suppress_start(struct zep_drv_if_ctx *if_ctx);
+
 #endif /* DRIVER_ZEPHYR_H */
