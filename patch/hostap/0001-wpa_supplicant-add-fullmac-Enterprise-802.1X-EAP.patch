 wpa_supplicant/wpas_glue.c        |   7 +-
 11 files changed, 347 insertions(+), 20 deletions(-)

diff --git a/src/crypto/tls.h b/src/crypto/tls.h
index 415d738d3..bca5ad85d 100644
--- a/src/crypto/tls.h
+++ b/src/crypto/tls.h
@@ -658,6 +658,17 @@ tls_connection_get_success_data(struct tls_connection *conn);
 
 void tls_connection_remove_session(struct tls_connection *conn);
 
+/**
+ * tls_global_session_cache_invalidate - Drop the cached global TLS session
+ * used for fast-reauth (abbreviated handshake) resumption, if any.
+ *
+ * Call this when EAP credentials configured for an SSID change (identity,
+ * password, or AKM), to prevent an abbreviated TLS handshake from resuming
+ * a session established under the OLD credentials and bypassing the inner
+ * EAP method (MSCHAPv2/PAP/CHAP) on the next connect attempt.
+ */
+void tls_global_session_cache_invalidate(void);
+
 /**
  * tls_get_tls_unique - Fetch "tls-unique" for channel binding
  * @conn: Connection context data from tls_connection_init()
diff --git a/src/crypto/tls_mbedtls_alt.c b/src/crypto/tls_mbedtls_alt.c
index 0e7124c8f..886c6f463 100644
--- a/src/crypto/tls_mbedtls_alt.c
+++ b/src/crypto/tls_mbedtls_alt.c
@@ -172,6 +172,9 @@ struct tls_global
     unsigned int crl_reload_interval;
     uint32_t refcnt;
     struct tls_config init_conf;
+
+    unsigned int has_saved : 1; /* saved_session holds a valid session for fast reauth */
+    mbedtls_ssl_session saved_session; /* global TLS session cache; persists across conn deinit */
 };
 
 static struct tls_global tls_ctx_global;
@@ -376,6 +379,9 @@ __attribute_cold__ void *tls_init(const struct tls_config *conf)
     if (++tls_ctx_global.refcnt > 1)
         return &tls_ctx_global;
 
+    mbedtls_ssl_session_init(&tls_ctx_global.saved_session);
+    tls_ctx_global.has_saved = 0;
+
 #if !defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)
     tls_ctx_global.ctr_drbg = crypto_mbedtls_ctr_drbg();
 #endif
@@ -410,12 +416,38 @@ __attribute_cold__ void tls_deinit(void *tls_ctx)
     char *openssl_ciphers; /*(allocated in tls_init())*/
     *(const char **)&openssl_ciphers = tls_ctx_global.init_conf.openssl_ciphers;
     os_free(openssl_ciphers);
+    mbedtls_ssl_session_free(&tls_ctx_global.saved_session);
 #ifdef MBEDTLS_SSL_SESSION_TICKETS
     mbedtls_ssl_ticket_free(&tls_ctx_global.ticket_ctx);
 #endif
     os_memset(&tls_ctx_global, 0, sizeof(tls_ctx_global));
 }
 
+/*
+ * tls_global_session_cache_invalidate - drop the cached global TLS session
+ * (used for EAP-TLS/PEAP/TTLS fast-reauth abbreviated handshake resumption).
+ *
+ * Called from qcom_wifi_enterprise_glue.c's qcom_ent_setup_supplicant() when
+ * this connect's credential fingerprint (identity||password||AKM) differs
+ * from the one recorded for this SSID.  Without this, a changed password
+ * (or identity) can still be accepted by an abbreviated TLS handshake that
+ * resumes the OLD (pre-change) session ID/master secret, which skips the
+ * inner EAP method (MSCHAPv2/PAP/CHAP) entirely -- the AP that has already
+ * cached this session-id would authenticate the DUT using the stale
+ * password, bypassing the credential change.  Invalidating the cache here
+ * forces a full TLS handshake (and therefore inner-method re-auth) on the
+ * next connect after a credential change, mirroring the firmware PMKSA
+ * invalidation done in the same code path.
+ */
+void tls_global_session_cache_invalidate(void)
+{
+    if (tls_ctx_global.has_saved) {
+        mbedtls_ssl_session_free(&tls_ctx_global.saved_session);
+        mbedtls_ssl_session_init(&tls_ctx_global.saved_session);
+        tls_ctx_global.has_saved = 0;
+    }
+}
+
 int tls_get_errors(void *tls_ctx)
 {
     return 0;
@@ -559,9 +591,18 @@ int tls_connection_shutdown(void *tls_ctx, struct tls_connection *conn)
 #endif
         tls_connection_deinit_expkey(conn);
 
-    /* RFE: prepare for session resumption? (see doc in crypto/tls.h) */
+    /* Fast reauth (Route A+): re-offer session from global cache so the
+     * next client_hello carries the prior session_id even after conn recreation. */
+    int _reset = mbedtls_ssl_session_reset(&conn->ssl);
+    if (_reset != 0)
+        return _reset;
 
-    return mbedtls_ssl_session_reset(&conn->ssl);
+    if (tls_ctx_global.has_saved) {
+        int _ss = mbedtls_ssl_set_session(&conn->ssl, &tls_ctx_global.saved_session);
+        wpa_printf(MSG_DEBUG, "MTLS: fast-reauth set_session (reauth) ret=%d", _ss);
+        /* Non-fatal on failure: handshake proceeds as full. */
+    }
+    return 0;
 }
 
 static int tls_wpabuf_resize_put_data(struct wpabuf **buf, const unsigned char *data, size_t dlen)
@@ -643,6 +684,15 @@ static int tls_mbedtls_ssl_setup(struct tls_connection *conn)
     if (conn->verify_peer)
         mbedtls_ssl_set_verify(&conn->ssl, tls_mbedtls_verify_cb, conn);
 
+    /* Fast reauth (Route A+): offer the saved session from the global cache so
+     * the first client_hello from this new conn carries the prior session_id. */
+    if (tls_ctx_global.has_saved) {
+        ret = mbedtls_ssl_set_session(&conn->ssl, &tls_ctx_global.saved_session);
+        wpa_printf(MSG_DEBUG, "MTLS: fast-reauth set_session (init) ret=%d", ret);
+        /* Non-fatal: handshake proceeds as full on failure. */
+        ret = 0;
+    }
+
     return 0;
 }
 
@@ -711,7 +761,7 @@ static void tls_mbedtls_set_allowed_tls_vers(struct tls_conf *tls_conf, mbedtls_
 
 __attribute_noinline__ static int tls_mbedtls_readfile(const char *path, u8 **buf, size_t *n);
 
-#ifdef MBEDTLS_DHM_C
+#if defined(MBEDTLS_DHM_C) && defined(MBEDTLS_SSL_SRV_C)
 static int tls_mbedtls_set_dhparams(struct tls_conf *tls_conf, const struct tls_connection_params *params)
 {
     size_t len;
@@ -1638,7 +1688,7 @@ static int tls_mbedtls_set_params(struct tls_conf *tls_conf, const struct tls_co
     if (ret != 0)
         return -1;
 
-#ifdef MBEDTLS_DHM_C
+#if defined(MBEDTLS_DHM_C) && defined(MBEDTLS_SSL_SRV_C)
     if (params->dh_blob && !tls_mbedtls_set_dhparams(tls_conf, params))
     {
         return -1;
@@ -1695,7 +1745,6 @@ int tls_connection_set_params(void *tls_ctx, struct tls_connection *conn, const
     if (tls_mbedtls_set_params(tls_conf, params) != 0)
         return -1;
     conn->verify_peer = tls_conf->verify_peer;
-
     return tls_mbedtls_ssl_setup(conn);
 }
 
@@ -2145,7 +2194,18 @@ struct wpabuf *tls_connection_handshake(void *tls_ctx,
             wpabuf_put(*appl_data, res);
     }
     else
-        ret = mbedtls_ssl_handshake(&conn->ssl);
+    {
+        int _s0, _s1;
+        do {
+            _s0 = (int)conn->ssl.MBEDTLS_PRIVATE(state);
+            printk("MTLS: step_enter state=%d\n", _s0);
+            ret = mbedtls_ssl_handshake_step(&conn->ssl);
+            _s1 = (int)conn->ssl.MBEDTLS_PRIVATE(state);
+            printk("MTLS: step_done state=%d->%d ret=%d\n", _s0, _s1, ret);
+            if (ret != 0)
+                break;
+        } while (_s1 != MBEDTLS_SSL_HANDSHAKE_OVER);
+    }
 #else
     int ret = 0;
     while (conn->ssl.MBEDTLS_PRIVATE(state) != MBEDTLS_SSL_HANDSHAKE_OVER)
@@ -2165,6 +2225,40 @@ struct wpabuf *tls_connection_handshake(void *tls_ctx,
     {
         case 0:
             conn->established = 1;
+
+            /* Fast reauth (Route A+): cache session in global so it persists
+             * across conn deinit/init cycles (conn is recreated on reconnect). */
+            {
+                mbedtls_ssl_session cur_session;
+                mbedtls_ssl_session_init(&cur_session);
+                if (mbedtls_ssl_get_session(&conn->ssl, &cur_session) == 0) {
+                    /* Spec Section 3a: detect resumption via session-ID match. */
+                    if (tls_ctx_global.has_saved &&
+                        cur_session.MBEDTLS_PRIVATE(id_len) > 0 &&
+                        cur_session.MBEDTLS_PRIVATE(id_len) ==
+                            tls_ctx_global.saved_session.MBEDTLS_PRIVATE(id_len) &&
+                        os_memcmp(cur_session.MBEDTLS_PRIVATE(id),
+                                  tls_ctx_global.saved_session.MBEDTLS_PRIVATE(id),
+                                  cur_session.MBEDTLS_PRIVATE(id_len)) == 0) {
+                        conn->resumed = 1;
+                    }
+                    /* Refresh: free prior session to avoid peer-cert leak. */
+                    if (tls_ctx_global.has_saved) {
+                        mbedtls_ssl_session_free(&tls_ctx_global.saved_session);
+                        mbedtls_ssl_session_init(&tls_ctx_global.saved_session);
+                        tls_ctx_global.has_saved = 0;
+                    }
+                    /* Transfer ownership into the global cache. */
+                    os_memcpy(&tls_ctx_global.saved_session, &cur_session, sizeof(cur_session));
+                    tls_ctx_global.has_saved = 1;
+                    /* Do NOT free cur_session -- ownership transferred. */
+                } else {
+                    mbedtls_ssl_session_free(&cur_session);
+                }
+            }
+            wpa_printf(MSG_DEBUG, "MTLS: fast-reauth resumed=%d has_saved=%d",
+                       conn->resumed, tls_ctx_global.has_saved);
+
             if (conn->push_buf == NULL)
                 /* Need to return something to get final TLS ACK. */
                 conn->push_buf = wpabuf_alloc(0);
@@ -2173,9 +2267,16 @@ struct wpabuf *tls_connection_handshake(void *tls_ctx,
         case MBEDTLS_ERR_SSL_WANT_READ:
         case MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS:
         case MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS:
-            if (tls_ctx_global.tls_conf /*(is server)*/
-                && conn->established && conn->push_buf == NULL)
-                /* Need to return something to trigger completion of EAP-TLS. */
+            /*wpa_printf(MSG_ERROR, "MTLS: mbedtls_ssl_handshake WANT_READ/WRITE push_buf=%s",
+                       conn->push_buf ? "non-null" : "null");
+                       */
+            if (conn->push_buf == NULL)
+                /* Need to return ACK (empty buf) so EAP-TLS requests
+                 * the next server fragment or triggers completion.
+                 * Original condition was server-only (tls_ctx_global.tls_conf
+                 * && conn->established) but client also needs ACK during
+                 * multi-exchange server hello flight (WANT_READ after
+                 * ServerHello+Cert, waiting for ServerKeyExchange etc.). */
                 conn->push_buf = wpabuf_alloc(0);
             break;
         default:
@@ -2200,12 +2301,16 @@ struct wpabuf *tls_connection_handshake(void *tls_ctx,
                     break;
             }
 
-            ilog(ret, "mbedtls_ssl_handshake");
+            //elog(ret, "mbedtls_ssl_handshake");
             break;
     }
 
     struct wpabuf *out_data = conn->push_buf;
     conn->push_buf          = NULL;
+    /*
+    wpa_printf(MSG_ERROR, "MTLS: handshake_exit ret=%d out_data=%s established=%d",
+               ret, out_data ? "non-null" : "NULL", conn->established);
+               */
     return out_data;
 }
 
@@ -2977,6 +3082,8 @@ static int tls_mbedtls_verify_cb(void *arg, mbedtls_x509_crt *crt, int depth, ui
     struct tls_conf *tls_conf   = conn->tls_conf;
     uint32_t flags_in           = *flags;
 
+    //wpa_printf(MSG_ERROR, "MTLS: verify_cb depth=%d flags_in=0x%08X", depth, flags_in);
+
 #if defined(TLS_MBEDTLS_CERT_DISABLE_KEY_USAGE_CHECK)
     crt->MBEDTLS_PRIVATE(ext_types) &= ~MBEDTLS_X509_EXT_KEY_USAGE;
     crt->MBEDTLS_PRIVATE(ext_types) &= ~MBEDTLS_X509_EXT_EXTENDED_KEY_USAGE;
@@ -3012,6 +3119,8 @@ static int tls_mbedtls_verify_cb(void *arg, mbedtls_x509_crt *crt, int depth, ui
     {
         if (!conn->peer_subject)
             tls_mbedtls_set_peer_subject(conn, crt);
+        //wpa_printf(MSG_ERROR, "MTLS: verify_cb depth=0 peer_subject=%s",
+        //           conn->peer_subject ? conn->peer_subject : "NULL(malloc_fail)");
         /*(use same labels to tls_mbedtls_verify_fail_event() as used in
          * other TLS modules so that hwsim tests find exact string match)*/
         if (!conn->peer_subject)
@@ -3172,6 +3281,7 @@ static int tls_mbedtls_verify_cb(void *arg, mbedtls_x509_crt *crt, int depth, ui
         }
     }
 
+    //wpa_printf(MSG_ERROR, "MTLS: verify_cb depth=%d flags_out=0x%08X", depth, *flags);
     return 0;
 }
 #endif
