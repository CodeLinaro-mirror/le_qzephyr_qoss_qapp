+		}
 #endif /* __ZEPHYR__ */
 #if defined(CONFIG_FILS) && defined(IEEE8021X_EAPOL)
 		if (!fils_hlp_sent && ssid && ssid->eap.erp)
@@ -7765,6 +7779,18 @@ static void wpas_periodic(void *eloop_ctx, void *timeout_ctx)
 	struct wpa_global *global = eloop_ctx;
 	struct wpa_supplicant *wpa_s;
 
+#ifdef __ZEPHYR__
+	/*
+	 * Device is in BMPS: skip the self-rearm so the eloop thread has no
+	 * short (10s) timeout pending, letting Zephyr's tickless idle reach
+	 * the AON-timer's real (DTIM-driven) wake deadline instead of being
+	 * capped at 10s.  wpas_bmps_resume_periodic() re-arms this from the
+	 * eloop thread when BMPS is exited (see events.c EVENT_BMPS_EXIT).
+	 */
+	if (atomic_get(&global->bmps_active))
+		return;
+#endif /* __ZEPHYR__ */
+
 	eloop_register_timeout(WPA_SUPPLICANT_CLEANUP_INTERVAL, 0,
 			       wpas_periodic, global, NULL);
 
@@ -7781,6 +7807,31 @@ static void wpas_periodic(void *eloop_ctx, void *timeout_ctx)
 	}
 }
 
+#ifdef __ZEPHYR__
+void wpas_bmps_pause_periodic(struct wpa_global *global)
+{
+	/*
+	 * Plain atomic write -- safe from any thread.  wpas_periodic() reads
+	 * this on its own next scheduled fire (already on the eloop thread)
+	 * and skips its self-rearm; no eloop API is touched here.
+	 */
+	atomic_set(&global->bmps_active, 1);
+}
+
+void wpas_bmps_resume_periodic(struct wpa_global *global)
+{
+	/*
+	 * Called on the eloop thread only (dispatched via
+	 * wpa_supplicant_event_global(EVENT_BMPS_EXIT) -- see events.c), so
+	 * touching eloop's timeout list here is safe.
+	 */
+	atomic_set(&global->bmps_active, 0);
+	eloop_cancel_timeout(wpas_periodic, global, NULL);
+	eloop_register_timeout(WPA_SUPPLICANT_CLEANUP_INTERVAL, 0,
+			       wpas_periodic, global, NULL);
+}
+#endif /* __ZEPHYR__ */
+
 
