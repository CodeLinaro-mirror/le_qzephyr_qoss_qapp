From c29a3add8f066760507f53999cca369b79f7ead4 Mon Sep 17 00:00:00 2001
From: Ronghua Zeng <ronghuaz@qti.qualcomm.com>
Date: Wed, 27 May 2026 17:30:26 -0700
Subject: [PATCH] crypto: tls_mbedtls_alt: guard tls_mbedtls_set_dhparams with
 SSL_SRV_C

The function tls_mbedtls_set_dhparams() configures DHE
parameters for a TLS server via mbedtls_ssl_conf_dh_param_bin(),
which is only available when MBEDTLS_SSL_SRV_C is enabled.
The existing guard was MBEDTLS_DHM_C alone, which is also
satisfied by client builds that enable DHE cipher suites
(MBEDTLS_DHM_C is pulled in by MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED
on the client side).

Add MBEDTLS_SSL_SRV_C to both the function definition
guard and the call-site guard in tls_mbedtls_set_params().
This prevents a build failure when CONFIG_MBEDTLS_SSL_SRV_C=n
on client-only targets (e.g. WPA supplicant builds that disable
the server-side TLS stack to save flash).

Change-Id: Id851ea6a947c25c4a3131b37953083e99e0d076f
---
 src/crypto/tls_mbedtls_alt.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/crypto/tls_mbedtls_alt.c b/src/crypto/tls_mbedtls_alt.c
index 244c49a8f..5698cfd9b 100644
--- a/src/crypto/tls_mbedtls_alt.c
+++ b/src/crypto/tls_mbedtls_alt.c
@@ -711,7 +711,7 @@ static void tls_mbedtls_set_allowed_tls_vers(struct tls_conf *tls_conf, mbedtls_
 
 __attribute_noinline__ static int tls_mbedtls_readfile(const char *path, u8 **buf, size_t *n);
 
-#ifdef MBEDTLS_DHM_C
+#if defined(MBEDTLS_DHM_C) && defined(MBEDTLS_SSL_SRV_C)
 static int tls_mbedtls_set_dhparams(struct tls_conf *tls_conf, const struct tls_connection_params *params)
 {
     size_t len;
@@ -1638,7 +1638,7 @@ static int tls_mbedtls_set_params(struct tls_conf *tls_conf, const struct tls_co
     if (ret != 0)
         return -1;
 
-#ifdef MBEDTLS_DHM_C
+#if defined(MBEDTLS_DHM_C) && defined(MBEDTLS_SSL_SRV_C)
     if (params->dh_blob && !tls_mbedtls_set_dhparams(tls_conf, params))
     {
         return -1;
-- 
