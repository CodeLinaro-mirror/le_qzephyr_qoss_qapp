+					PR_WARNING("Too many channels (max %d)\n",
+						   WIFI_WPS_MAX_CHANNELS);
+					return -EINVAL;
+				}
+				params.channels[params.channel_count++] =
+					(uint16_t)ch;
+				tok = strtok_r(NULL, ",", &saveptr);
+			}
+			if (params.channel_count == 0) {
