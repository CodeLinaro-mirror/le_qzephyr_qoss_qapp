+++ b/modules/hostap/src/wps_registrar_stub.c
@@ -0,0 +1,69 @@
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * wps_registrar_stub.c -- Enrollee-only stub for wps_registrar symbols.
+ *
+ * QCC730 acts as WPS Enrollee only.  The registrar code (wps_registrar.c,
+ * ~60 KB) is not compiled in.  wps.c references a small number of registrar
+ * symbols inside "if (data->registrar)" guards that are never reached in
+ * enrollee mode (data->registrar is always NULL).  These stubs satisfy the
+ * linker without pulling in the full registrar implementation.
+ *
+ * If any stub is unexpectedly called at runtime, it logs an error and
+ * returns a safe failure value -- this makes silent mis-use visible.
+ */
+
+#include "includes.h"
+#include "common.h"
+#include "wps_i.h"
+#include "utils/wpabuf.h"
+
+struct wpabuf * wps_registrar_get_msg(struct wps_data *wps,
+                                      enum wsc_op_code *op_code)
+{
+    wpa_printf(MSG_ERROR, "WPS: wps_registrar_get_msg called in enrollee-only build");
+    return NULL;
+}
+
+enum wps_process_res wps_registrar_process_msg(struct wps_data *wps,
+                                                enum wsc_op_code op_code,
+                                                const struct wpabuf *msg)
+{
+    wpa_printf(MSG_ERROR, "WPS: wps_registrar_process_msg called in enrollee-only build");
+    return WPS_FAILURE;
+}
+
+int wps_build_cred(struct wps_data *wps, struct wpabuf *msg)
+{
+    wpa_printf(MSG_ERROR, "WPS: wps_build_cred called in enrollee-only build");
+    return -1;
+}
+
+int wps_registrar_invalidate_pin(struct wps_registrar *reg, const u8 *uuid)
+{
+    return 0;
+}
+
+int wps_registrar_unlock_pin(struct wps_registrar *reg, const u8 *uuid)
+{
+    return 0;
+}
+
+void wps_registrar_remove_nfc_pw_token(struct wps_registrar *reg,
+                                        struct wps_nfc_pw_token *token)
+{
+}
+
+int wps_device_store(struct wps_registrar *reg,
+                     struct wps_device_data *dev, const u8 *uuid)
+{
+    return 0;
+}
+
+int wps_cb_new_psk(struct wps_registrar *reg, const u8 *mac_addr,
+                   const u8 *p2p_dev_addr, const u8 *psk, size_t psk_len)
+{
+    return 0;
+}
