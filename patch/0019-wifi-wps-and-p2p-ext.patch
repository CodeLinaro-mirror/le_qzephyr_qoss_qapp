+			break;
+		case 'c': {
+			/* Comma-separated channel list, e.g. "6,11,36" */
+			char buf[64];
+			char *tok;
+			char *saveptr;
+
+			strlcpy(buf, state->optarg, sizeof(buf));
+
+			tok = strtok_r(buf, ",", &saveptr);
+			while (tok) {
+				char *endp;
+				long ch = strtol(tok, &endp, 10);
+
+				if (*endp != '\0' ||
