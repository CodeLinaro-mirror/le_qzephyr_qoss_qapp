+			}
+			break;
+		}
+		case 'i':
+			/* Consumed by get_iface(), ignore here */
+			break;
+		case 'h':
+			shell_help(sh);
+			return 0;
+		default:
+			PR_WARNING("Invalid option: %c\n", opt);
+			shell_help(sh);
+			return -EINVAL;
+		}
 	}
 
 	if (net_mgmt(NET_REQUEST_WIFI_WPS_CONFIG, iface, &params, sizeof(params))) {
