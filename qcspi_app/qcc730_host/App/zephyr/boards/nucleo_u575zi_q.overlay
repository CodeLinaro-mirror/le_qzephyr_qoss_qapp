&gpdma1 {
    status = "okay";
};


&spi1 {
    status = "okay";
    /* Enable SPI FIFO to reduce the latency between two bytes */
    fifo-enable;

    dmas = <&gpdma1 0 7 0x10440>,   /* TX */
           <&gpdma1 1 6 0x10480>;   /* RX */
    dma-names = "tx", "rx";

    /* Software-controlled CS on PA4 */
    /* cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>; */

    spi_slave: spi-slave@0 {
        compatible = "zephyr,spi-device";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <20000000>;
    };
};

/ {
    /* GPIO for QCC730 interrupt notification (730→Host) */
    qcc730_irq {
        compatible = "gpio-keys";
        qcc730_ring_irq: qcc730_ring_irq {
            gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>;
            label = "QCC730 Ring IRQ";
        };
    };
};
