+#if DT_HAS_COMPAT_STATUS_OKAY(qcom_qcc730_clkctrl)
+/* Test UART and GPIO clock register writes */
+ZTEST(clock_control, test_uart_gpio_register_writes)
+{
+	const struct device *clk_dev = DEVICE_DT_GET(DT_NODELABEL(clock_controller));
+	int err;
+	static PMU_BASE_pmu_Type *pmu = (PMU_BASE_pmu_Type *)PMU_BASE_ADDR;
+	/* Variables to store register bit values */
+	uint8_t uart_root_off, gpio_root_off;
+	uint8_t uart_root_on, gpio_root_on;
+
+	LOG_INF("=== Testing UART and GPIO Register Writes ===");
+	zassert_true(device_is_ready(clk_dev), "Clock device not ready");
+
+	/* Turn OFF both clocks first */
+	err = clock_control_off(clk_dev, (clock_control_subsys_t)QCC730_CLOCK_UART);
+	err = clock_control_off(clk_dev, (clock_control_subsys_t)QCC730_CLOCK_GPIO);
+
+	/* Read and store OFF register bit values */
+	uart_root_off = pmu->PMU_ROOT_CLK_ENABLE.bit.UART_ROOT_CLK_ENABLE;
+	gpio_root_off = pmu->PMU_ROOT_CLK_ENABLE.bit.GPIO_ROOT_CLK_ENABLE;
+
+	/* Turn ON both clocks for logging capability */
+	err = clock_control_on(clk_dev, (clock_control_subsys_t)QCC730_CLOCK_UART);
+	err = clock_control_on(clk_dev, (clock_control_subsys_t)QCC730_CLOCK_GPIO);
+
+	/* Read and store ON register bit values */
+	uart_root_on = pmu->PMU_ROOT_CLK_ENABLE.bit.UART_ROOT_CLK_ENABLE;
+	gpio_root_on = pmu->PMU_ROOT_CLK_ENABLE.bit.GPIO_ROOT_CLK_ENABLE;
+
+	/* Log the stored register bit values */
+	LOG_INF("UART OFF - ROOT_CLK: %d", uart_root_off);
+	LOG_INF("UART ON  - ROOT_CLK: %d", uart_root_on);
+	LOG_INF("GPIO OFF - ROOT_CLK: %d", gpio_root_off);
+	LOG_INF("GPIO ON  - ROOT_CLK: %d", gpio_root_on);
+
+	/* Test against stored OFF values */
+	zassert_equal(0, uart_root_off, "UART ROOT bit should be 0 when OFF");
+	zassert_equal(0, gpio_root_off, "GPIO ROOT bit should be 0 when OFF");
+
+	/* Test against stored ON values */
+	zassert_equal(1, uart_root_on, "UART ROOT bit should be 1 when ON");
+	zassert_equal(1, gpio_root_on, "GPIO ROOT bit should be 1 when ON");
+
+	LOG_INF("UART and GPIO clock register write test PASSED");
+}
+#endif // DT_HAS_COMPAT_STATUS_OKAY(qcom_qcc730_clkctrl)
