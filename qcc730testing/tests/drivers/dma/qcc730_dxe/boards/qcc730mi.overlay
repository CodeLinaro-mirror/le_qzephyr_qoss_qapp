&dxe0 {
	status = "okay";
};

&rram {
	reg = <0x00222400 0x0015CC00>;
};

/ {
	soc {
		rram_test: rram_test@37f000 {
			compatible = "zephyr,memory-region";
			reg = <0x0037F000 0x00003000>;
			zephyr,memory-region = "rram_test";
			label = "rram_test";
		};
	};
};
