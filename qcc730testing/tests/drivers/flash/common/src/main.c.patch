+ZTEST(flash_driver, test_suspend_resume)
+{
+	int rc;
+	uint8_t write_buf[24] = { 0xDE, 0xAD, 0xBE, 0xEF };
+	uint8_t read_buf[24] = { 0 };
+	uint8_t *ret_ptr = NULL;
+
+	/* Pre-condition: erase region, write data, read back and verify */
+	rc = flash_erase(flash_dev, page_info.start_offset, sizeof(write_buf));
+	zassert_ok(rc, "Erase before suspend failed");
+
+	rc = flash_write(flash_dev, page_info.start_offset, write_buf, sizeof(write_buf));
+	zassert_ok(rc, "Write before suspend failed");
+
+	rc = flash_read(flash_dev, page_info.start_offset, read_buf, sizeof(write_buf));
+	zassert_ok(rc, "Read before suspend failed");
+	zassert_mem_equal(read_buf, write_buf, sizeof(write_buf), "Data mismatch before suspend");
+
+	/* Suspend the device */
+	rc = pm_device_action_run(flash_dev, PM_DEVICE_ACTION_SUSPEND);
+	zassert_ok(rc, "Flash suspend failed");
+
+	/* Attempt erase, write, read while suspended – expect -EBUSY error */
+	rc = flash_erase(flash_dev, page_info.start_offset, sizeof(write_buf));
+	zassert_true(rc < 0, "Erase after suspend should fail");
+
+	rc = flash_write(flash_dev, page_info.start_offset, write_buf, sizeof(write_buf));
+	zassert_true(rc < 0, "Write after suspend should fail");
+
+	ret_ptr = memset(read_buf, 0, sizeof(read_buf));
+	zassert_true(ret_ptr != NULL, "memset fail");
+	rc = flash_read(flash_dev, page_info.start_offset, read_buf, sizeof(write_buf));
+	zassert_true(rc < 0, "Read after suspend should fail");
+
+	/* Resume the device */
+	rc = pm_device_action_run(flash_dev, PM_DEVICE_ACTION_RESUME);
+	zassert_ok(rc, "Flash resume failed");
+
+	/* Post‐condition: read and verify data matches what was written during “suspended” state */
+	memset(read_buf, 0, sizeof(read_buf));
+	rc = flash_read(flash_dev, page_info.start_offset, read_buf, sizeof(write_buf));
+	zassert_ok(rc, "Read after resume failed");
+	zassert_mem_equal(read_buf, write_buf, sizeof(write_buf), "Data mismatch after resume");
+}
+
 ZTEST_SUITE(flash_driver, NULL, NULL, flash_driver_before, NULL, NULL);
