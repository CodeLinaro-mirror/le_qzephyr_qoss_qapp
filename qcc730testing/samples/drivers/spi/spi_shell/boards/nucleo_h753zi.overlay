&spi1 {
    status = "okay";
    spi_slave: spi-slave@0 {
        compatible = "zephyr,spi-device";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <20000000>;
        cs-gpios = <&gpiod 14 GPIO_ACTIVE_LOW>;
    };
};