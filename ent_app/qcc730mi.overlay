 *
 * Board overlay for qcc730mi: add a LittleFS cert partition on external QSPI
 * NOR flash (qspi_nor_flash3, GT25Q32AU 4 MB) at offset 0x3000, size 64 KB.
 *
 * This file is auto-included by the Zephyr build system for the qcc730mi
 * board when building qcli_app.
 */

&qspi_nor_flash3 {
	status = "okay";
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		cert_partition: cert@3000 {
			label = "cert";
			reg = <0x3000 0x10000>; /* 64 KB at offset 0x3000 */
		};
	};
};
